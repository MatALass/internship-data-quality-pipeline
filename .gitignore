# ============================================================
# Données (RGPD) : rien n'est versionné sauf le jeu de démonstration fictif
# ============================================================
# Export réel, sorties intermédiaires, final, rapports et historique : nominatifs ou dérivés
# de l'export réel. Le pipeline les régénère ; le jeu public est data/demo/.
data/raw/*
data/interim/*
data/processed/*
data/reports/*
!data/*/.gitkeep
!data/demo/
# Power BI : un .pbix embarque les données qu'il a chargées
powerbi/*.pbix

# Décisions de fusion entreprises : pas de données personnelles, mais dérivées
# du dataset nominatif et propres à cette extraction — pas versionnées par défaut.
data/reference/*
!data/reference/.gitkeep
